{
  "name": "darknode-app",
  "version": "2.40.0",
  "description": "Darknode — desktop security console (runs tools, a live terminal, and local AI)",
  "main": "main.js",
  "author": "Darknode <contact@darknode.ai>",
  "homepage": "https://darknode.ai",
  "license": "UNLICENSED",
  "keywords": [
    "security",
    "pentest",
    "electron",
    "port-scanner",
    "terminal",
    "code-editor",
    "local-ai",
    "ollama",
    "infosec",
    "recon"
  ],
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "test": "node test/run.mjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist": "electron-builder -mwl",
    "publish:release": "bash scripts/publish-release.sh"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.darknode.console",
    "productName": "Darknode",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Darknode <contact@darknode.ai>",
      "category": "Development",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
