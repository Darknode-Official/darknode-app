{
  "name": "darknode-app",
  "version": "2.54.0",
  "description": "Darknode — desktop security console (runs tools, a live terminal, and local AI)",
  "main": "main.js",
  "author": "Darknode <contact@darknode.ai>",
  "homepage": "https://darknode.ai",
  "license": "UNLICENSED",
  "keywords": [
    "security",
    "pentest",
    "electron",
    "port-scanner",
    "terminal",
    "code-editor",
    "local-ai",
    "ollama",
    "infosec",
    "recon"
  ],
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "sync-web": "node scripts/sync-web.mjs",
    "prestart": "node scripts/sync-web.mjs",
    "start": "electron .",
    "test": "node test/run.mjs",
    "e2e:webshell": "electron test/e2e/webshell.e2e.cjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "predist:linux": "node scripts/sync-web.mjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "predist:win": "node scripts/sync-web.mjs",
    "dist:win": "electron-builder --win nsis",
    "predist:mac": "node scripts/sync-web.mjs",
    "dist:mac": "electron-builder --mac dmg zip",
    "predist": "node scripts/sync-web.mjs",
    "dist": "electron-builder -mwl",
    "publish:release": "bash scripts/publish-release.sh"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.darknode.console",
    "productName": "Darknode",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "design/**/*",
      "web/**/*",
      "web/.source.json",
      "web/.hosting.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Darknode <contact@darknode.ai>",
      "category": "Development",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Darknode-Official",
        "repo": "darknode-app",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  }
}
